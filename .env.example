# ─────────────────────────────────────────────────────────────
# The Unorthodox School — environment variables (example)
# Copy to .env.local and fill in real values. Never commit secrets.
# ─────────────────────────────────────────────────────────────

# Public site configuration (safe to expose to the browser)
NEXT_PUBLIC_SITE_URL=https://www.theunorthodoxschool.com
NEXT_PUBLIC_GITHUB_ORG_URL=https://github.com/unorthodox-school
NEXT_PUBLIC_SUPPORT_EMAIL=didier@theunorthodoxschool.com

# Enrollment status: open | waitlist | closed
NEXT_PUBLIC_ENROLLMENT_STATUS=open

# Supabase (required for authentication + learner data).
# Get these from your Supabase project dashboard: Settings → API.
# The anon key is safe for the browser. NEVER expose the service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used exclusively by server code / migrations tooling.
# Do NOT prefix with NEXT_PUBLIC and never import into client components.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: forward each application submission to an automation webhook
# (Zapier / Make / n8n). Leave blank to skip.
WEBHOOK_URL=
